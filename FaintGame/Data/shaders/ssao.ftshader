#shader vertex
#version 460 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aTexCoord;

out vec2 TexCoord;

void main() {
	TexCoord = aTexCoord;
	gl_Position = vec4(aPos, 1);
}

#shader fragment
#version 460 core
in vec2 TexCoord;
out float FragOut;

layout(std430, binding = 0) buffer Camera {
	mat4 u_projection;
	mat4 u_view;
};

layout (binding = 0) uniform sampler2D gPosition;
layout (binding = 1) uniform sampler2D gNormal;
layout (binding = 2) uniform sampler2D gTexNoise;

const int KERNEL_SIZE = 64;
uniform vec3 samples[64];
uniform vec2 noiseSize;

uniform float radius = 0.5;
uniform float bias = 0.025;
uniform float u_power = 3.2;

void main() {
	vec2 noiseScale = vec2(noiseSize.x / 4.0, noiseSize.y / 4.0);

    vec3 fragPos   = texture(gPosition, TexCoord).xyz;         // view-space pos
    vec3 normal    = normalize(texture(gNormal, TexCoord).rgb); // ensure normalized
    vec3 randomVec = texture(gTexNoise, TexCoord * noiseScale).xyz;

    // construct TBN in view-space
    vec3 tangent   = normalize(randomVec - normal * dot(randomVec, normal));
    vec3 bitangent = normalize(cross(normal, tangent));
    mat3 TBN       = mat3(tangent, bitangent, normal);

    float occlusion = 0.0;
    for (int i = 0; i < KERNEL_SIZE; ++i) {
        // sample in tangent space, then to view-space
        vec3 sampleVec = TBN * samples[i]; // tangent -> view-space
        vec3 samplePos = fragPos + sampleVec * radius;

        // project sample position to clip space
        vec4 offset = vec4(samplePos, 1.0);
        offset = u_projection * offset; // view-space -> clip-space
        offset.xyz /= offset.w;
        vec2 sampleUV = offset.xy * 0.5 + 0.5;

        // discard samples outside screen
        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0)
            continue;

        float sampleDepth = texture(gPosition, sampleUV).z; // view-space depth

        // range check & accumulate
        float rangeCheck = smoothstep(0.0, 1.0, radius / abs(fragPos.z - sampleDepth));
        if (sampleDepth >= samplePos.z + bias)
            occlusion += 1.0 * rangeCheck;
    }

    occlusion = 1.0 - (occlusion / float(KERNEL_SIZE));
    FragOut = occlusion;
}
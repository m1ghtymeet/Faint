#shader vertex
#version 450 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aTexCoord;
out vec2 TexCoord;

void main() {
	TexCoord = aTexCoord;
	gl_Position = vec4(aPos, 1.0);
}

#shader fragment
#version 450 core
in vec2 TexCoord;
out float Occlusion;  // خروجی تک کاناله

uniform sampler2D depthTexture;
uniform vec2 lightPosScreen = vec2(0, 1);  // موقعیت نور در screen space (0-1)
uniform float exposure = 0.2;  // شدت کلی
uniform float decay = 0.96815;  // کاهش شدت با فاصله
uniform float density = 0.926;  // تراکم پرتوها
uniform float weight = 0.4;     // وزن هر sample
uniform int numSamples = 100;   // تعداد sample‌ها (کیفیت vs performance)

float getDepth(vec2 coords) {
    float depth = texture(depthTexture, coords).r;
    return depth;  // linearize اگر لازم باشه: depth / (1.0 - depth * nearFar)
}

void main() {
    vec2 delta = TexCoord - lightPosScreen;
    vec2 dir = delta / numSamples;  // جهت step
    float illumination = 0.0;

    for (int i = 0; i < numSamples; ++i) {
        vec2 pos = lightPosScreen + dir * float(i);
        float sampleDepth = getDepth(pos);

        // مقایسه depth: اگر sampleDepth < lightDepth، occludedه
        float lightDepth = getDepth(lightPosScreen);  // یا uniform lightDepth
        if (sampleDepth > lightDepth) {  // فرض view space
            illumination += exp2(-sampleDepth * density * weight);
        }
    }

    // اعمال decay
    illumination *= exposure * pow(decay, length(delta) * density);
    Occlusion = illumination / float(numSamples);
}
#shader vertex
#version 450 core
layout (location = 0) in vec3 vPosition;
layout (location = 1) in vec3 vColor;

layout(std430, binding = 0) buffer Camera {
	mat4 u_projection;
	mat4 u_view;
};

out vec3 Color;
out float depth;

void main() {
	vec4 worldPos = vec4(vPosition, 1.0);
	vec4 viewPos = u_view * worldPos;
	Color = vColor;
	depth = -viewPos.z;
	gl_Position = u_projection * viewPos;
}
#shader fragment
#version 450 core
layout (location = 0) out vec4 FragOut;
in vec3 Color;
uniform float u_colorEffect;

void main() {
	FragOut = vec4(Color * u_colorEffect, 1);
}
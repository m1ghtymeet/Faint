#shader vertex
#version 460
out vec3 WorldPos;

layout(std430, binding = 0) buffer Camera {
	mat4 u_projection;
	mat4 u_view;
};

uniform float gGridSize = 100.0;
uniform vec3 u_cameraPos;

const vec3 Pos[4] = vec3[4](
	vec3(-1.0, 0.0, -1.0),
	vec3( 1.0, 0.0, -1.0),
	vec3( 1.0, 0.0,  1.0),
	vec3(-1.0, 0.0,  1.0)
);

const int Indices[6] = int[6](0, 2, 1, 2, 0, 3);

void main() {
	int Index = Indices[gl_VertexID];
	vec3 aPos = Pos[Index] * gGridSize;
	
	//aPos.x += u_cameraPos.x;
	//aPos.z += u_cameraPos.z;
	
	WorldPos = aPos + vec3(u_cameraPos.x, 0.0, u_cameraPos.z);
	gl_Position = u_projection * u_view * vec4(WorldPos, 1.0);
}

#shader fragment
#version 460
in vec3 WorldPos;
layout (location = 0) out vec4 FragOut;

uniform vec3 u_cameraPos;
uniform float gGridSize = 100.0;
uniform float gGridMinPixelsBetweenCells = 2.0;
uniform float gGridCellSize = 0.025;
uniform vec4 gGridColorThin = vec4(0.5, 0.5, 0.5, 1.0);
uniform vec4 gGridColorThick = vec4(0.7, 0.7, 0.7, 1.0);
uniform vec2 gScreenSize = vec2(800, 600);

// Depth
layout (binding = 0) uniform sampler2D u_sceneDepth;

float log10(float x) { return log(x) / log(10.0); }
vec2 satv(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }
float satf(float x) { return clamp(x, 0.0, 1.0); }
float max2(vec2 v) { return max(v.x, v.y); }
float LinearizeDepth(float depth, float near, float far) {
    float z = depth * 2.0 - 1.0; // back to NDC
    return (2.0 * near * far) / (far + near - z * (far - near));
}

void main() {
	vec2 dvx = vec2(dFdx(WorldPos.x), dFdy(WorldPos.x));
	vec2 dvy = vec2(dFdx(WorldPos.z), dFdy(WorldPos.z));
	
	float lx = length(dvx);
	float ly = length(dvy);
	
	vec2 dudv = vec2(lx, ly);
	
	float l = length(dudv);
	
	float LOD = max(0.0, log10(l * gGridMinPixelsBetweenCells / gGridCellSize) + 1.0);
	float GridCellSizeLod0 = gGridCellSize * pow(10.0, floor(LOD));
	float GridCellSizeLod1 = GridCellSizeLod0 * 10.0;
	float GridCellSizeLod2 = GridCellSizeLod1 * 10.0;
	
	dudv *= 4.0;
	
	vec2 mod_div_dudv = mod(WorldPos.xz, GridCellSizeLod0) / dudv;
    float Lod0a = max2(vec2(1.0) - abs(satv(mod_div_dudv) * 2.0 - vec2(1.0)) );

    mod_div_dudv = mod(WorldPos.xz, GridCellSizeLod1) / dudv;
    float Lod1a = max2(vec2(1.0) - abs(satv(mod_div_dudv) * 2.0 - vec2(1.0)) );
    
    mod_div_dudv = mod(WorldPos.xz, GridCellSizeLod2) / dudv;
    float Lod2a = max2(vec2(1.0) - abs(satv(mod_div_dudv) * 2.0 - vec2(1.0)) );
	
	float LOD_fade = fract(LOD);
	vec4 Color;
	
	if (Lod2a > 0.0) {
		Color = gGridColorThick;
		Color.a *= Lod2a;
	}
	else {
		if (Lod1a > 0.0) {
			Color = mix(gGridColorThick, gGridColorThin, LOD_fade);
			Color.a *= Lod1a;
		}
		else {
			Color = gGridColorThin;
			Color.a *= (Lod0a * (1.0 - LOD_fade));
		}
	}
	
	float OpacityFalloff = (1.0 - satf(length(WorldPos.xz - u_cameraPos.xz) / gGridSize));
	Color.a *= OpacityFalloff;
	
	// === Fade behind objects ===
	vec2 uv = gl_FragCoord.xy / gScreenSize;
	float sceneDepth = LinearizeDepth(texture(u_sceneDepth, uv).r, 0.1, 100.0);
	float gridDepth = LinearizeDepth(gl_FragCoord.z, 0.1, 100.0);
	
	if (gridDepth > sceneDepth + 0.0001) {
		Color.a *= 0.25;
	}
	
	FragOut = Color;
}
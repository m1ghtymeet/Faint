#shader vertex
#version 450 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aTexCoord;
out vec2 TexCoord;

void main() {
	TexCoord = aTexCoord;
	gl_Position = vec4(aPos.xy, 0.0, 1.0);
}
#shader fragment
#version 450 core
in vec2 TexCoord;
out vec4 FragOut;

layout (binding = 0) uniform sampler2D sceneTexture;
layout (binding = 1) uniform sampler2D uiTexture;
layout (binding = 2) uniform sampler2D uiTextTexture;
layout (binding = 3) uniform sampler2D ssaoTexture;
layout (binding = 4) uniform sampler2D bloomTexture;
layout (binding = 6) uniform sampler2D depthTexture;

uniform float u_godRayIntensity = 1.0;

vec3 ACESFilm(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main() {
	vec3 sceneColor = texture(sceneTexture, TexCoord).rgb;
	vec4 uiColor = texture(uiTexture, TexCoord);
    float ssao = texture(ssaoTexture, TexCoord).r;
	vec3 bloomColor = texture(bloomTexture, TexCoord).rgb;
	float depth = texture(depthTexture, TexCoord).r;
    sceneColor *= ssao;
	vec3 finalColor = sceneColor /*+ bloomColor*/;

	// Tone mapping (ACES Filmic)
    finalColor = ACESFilm(finalColor);

	// Composite UI layers
    finalColor = mix(finalColor, uiColor.rgb, uiColor.a);

    FragOut = vec4(finalColor, 1.0);
}
// ============================================
// bloom_upsample.vert
// ============================================
#shader vertex
#version 450 core

layout(location = 0) in vec3 a_position;
layout(location = 1) in vec2 a_texCoords;

out vec2 v_texCoords;

void main() {
    v_texCoords = a_texCoords;
    gl_Position = vec4(a_position, 1.0);
}

// ============================================
// bloom_upsample.frag - Dual Kawase Blur Up
// ============================================
#shader fragment
#version 450 core

in vec2 v_texCoords;
out vec4 FragColor;

uniform sampler2D u_sourceTexture;
uniform float u_scatter = 0.7; // مقدار پخش نور (0.7 معمولی)

vec3 KarisAverage(vec3 col) {
    float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
    return col / (1.0 + luma);
}

void main() {
    vec2 texelSize = 1.0 / textureSize(u_sourceTexture, 0);
    float x = texelSize.x * u_scatter;
    float y = texelSize.y * u_scatter;

    vec3 sum = vec3(0.0);
    
    // 9-tap tent + Karis
    sum += KarisAverage(texture(u_sourceTexture, v_texCoords).rgb) * 4.0;
    sum += KarisAverage(texture(u_sourceTexture, v_texCoords + vec2(-x, -y)).rgb);
    sum += KarisAverage(texture(u_sourceTexture, v_texCoords + vec2( x, -y)).rgb);
    sum += KarisAverage(texture(u_sourceTexture, v_texCoords + vec2(-x,  y)).rgb);
    sum += KarisAverage(texture(u_sourceTexture, v_texCoords + vec2( x,  y)).rgb);
    
    sum += KarisAverage(texture(u_sourceTexture, v_texCoords + vec2( 0, -y*2)).rgb) * 0.5;
    sum += KarisAverage(texture(u_sourceTexture, v_texCoords + vec2(-x*2,  0)).rgb) * 0.5;
    sum += KarisAverage(texture(u_sourceTexture, v_texCoords + vec2( x*2,  0)).rgb) * 0.5;
    sum += KarisAverage(texture(u_sourceTexture, v_texCoords + vec2( 0,  y*2)).rgb) * 0.5;

    FragColor = vec4(sum / 10.0, 1.0);
}